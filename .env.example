# StoryNavigation client configuration.
#
# NOTE: StoryNavigation needs NO credentials or secrets. The client bootstraps
# its own session + Laravel CSRF token automatically. These variables are only
# knobs for the rev-eng agent and the e2e tests — none are required to run the
# library itself.

# Instagram username the e2e / rev-eng runs probe against (public profile).
STORYNAVIGATION_USERNAME=natgeo

# Base URL override. Defaults to https://storynavigation.com
# The mirror deployment https://storynavigation.com/mystorysaver-data also works.
# STORYNAVIGATION_BASE_URL=https://storynavigation.com
