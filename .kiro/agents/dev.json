{
  "name": "dev",
  "description": "Development agent — implements the storynavigation-client TypeScript library from API docs",
  "prompt": "file://../prompts/dev.md",
  "resources": ["file://docs/**/*.md", "file://AGENTS.md", "file://.kiro/steering/**/*.md"],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "code"
  ],
  "allowedTools": ["read", "grep", "glob", "code"],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        ".kiro/**",
        "lib/**",
        "test/**",
        "docs/**",
        "scripts/**",
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "biome.json",
        "vitest.config.ts",
        "tsdown.config.ts",
        "README.md",
        "AGENTS.md"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [".*git commit.*", ".*git push.*", ".*git tag .*", ".*npm publish.*"]
    }
  }
}
